/* ═══════════════════════════════════════════════════
   企鹅物流果实屯放仓库 · 现代重构版
   Theme: Modern Logistics / Tech Blue
   ═══════════════════════════════════════════════════ */

:root {
  --primary:       #2563eb;   /* 核心蓝 */
  --primary-hover: #1d4ed8;
  --primary-lt:    #dbeafe;
  --secondary:     #64748b;   /* 冷灰蓝 */
  --accent:        #8b5cf6;   /* 紫色点缀 */
  
  --success:       #10b981;
  --danger:        #ef4444;
  --warning:       #f59e0b;
  
  --bg:            #f8fafc;   /* 极浅灰蓝背景 */
  --card:          #ffffff;
  --text:          #0f172a;   /* 深色文字 */
  --text-lt:       #64748b;   /* 次要文字 */
  --border:        #e2e8f0;   /* 细边框 */
  --shadow-sm:     0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow:        0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg:     0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  
  --r:             12px;      /* 标准圆角 */
  --r-lg:          20px;      /* 大圆角 */
  --r-sm:          8px;       /* 小圆角 */
}

/* ══ 基础重置 ═══════════════════════════════════════ */
* { 
  box-sizing: border-box; 
  margin: 0; 
  padding: 0; 
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  background: var(--bg);
  min-height: 100vh;
  color: var(--text);
  font-size: 14px;
  line-height: 1.6;
}

button, input, select, textarea {
  font-family: inherit;
}

/* ══ 滚动条美化 ══════════════════════════════════════ */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

/* ══ 配置引导 & 横幅 ══════════════════════════════════ */
.setup-guide {
  background: #fff;
  border: 1px solid var(--warning);
  border-left: 4px solid var(--warning);
  border-radius: var(--r);
  padding: 20px;
  max-width: 720px;
  margin-bottom: 16px;
  box-shadow: var(--shadow);
}
.setup-title { font-weight: 700; color: var(--warning); margin-bottom: 12px; font-size: 16px; display: flex; align-items: center; gap: 8px; }
.setup-steps { padding-left: 24px; font-size: 13px; color: var(--text-lt); }
.setup-steps li { margin-bottom: 8px; }
.setup-steps code { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: 2px 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; color: var(--danger); }

.first-run-banner {
  background: linear-gradient(135deg, #6366f1, #a855f7);
  color: #fff;
  border-radius: var(--r);
  padding: 14px 24px;
  font-weight: 600;
  text-align: center;
  max-width: 720px;
  box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
  animation: slideDown 0.5s ease-out;
}
@keyframes slideDown { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

/* ══ 登录/注册 页 ════════════════════════════════════ */
#entry-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
  background: radial-gradient(circle at top right, #e0e7ff, transparent),
              radial-gradient(circle at bottom left, #f0fdf4, transparent);
}
.entry-wrap {
  width: 100%;
  max-width: 800px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
}

.entry-logo { text-align: center; }
.logo-emoji {
  font-size: 80px;
  display: block;
  margin-bottom: 16px;
  filter: drop-shadow(0 10px 15px rgba(37, 99, 235, 0.2));
  animation: float 6s ease-in-out infinite;
}
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }

.entry-logo h1 {
  font-size: 28px;
  font-weight: 800;
  color: var(--text);
  letter-spacing: -0.5px;
  margin-bottom: 8px;
}
.entry-logo p { font-size: 15px; color: var(--text-lt); font-weight: 500; }

.entry-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  width: 100%;
}
@media (max-width: 640px) { .entry-cards { grid-template-columns: 1fr; } }

.auth-card { 
  background: var(--card);
  border-radius: var(--r-lg); 
  padding: 32px; 
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
  transition: transform 0.3s ease;
}
.auth-card:hover { transform: translateY(-4px); }
.auth-card h2 { font-size: 20px; font-weight: 700; margin-bottom: 24px; text-align: center; color: var(--text); }

.login-card {
  background: var(--text);
  color: #fff;
  border: none;
}
.login-card h2 { color: #fff; }
.login-card .field label { color: #94a3b8; }
.login-card .field input { background: #1e293b; border-color: #334155; color: #fff; }
.login-card .field input:focus { border-color: var(--primary); box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.3); }

.field { margin-bottom: 20px; }
.field label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px; color: var(--text-lt); }
.field input {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  font-size: 14px;
  transition: all 0.2s;
  background: #f8fafc;
}
.field input:focus {
  outline: none;
  border-color: var(--primary);
  background: #fff;
  box-shadow: 0 0 0 4px var(--primary-lt);
}

.btn-reg, .btn-login {
  width: 100%;
  padding: 14px;
  border-radius: var(--r-sm);
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  border: none;
}
.btn-reg { background: var(--primary); color: #fff; }
.btn-reg:hover { background: var(--primary-hover); box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3); }

.btn-login { background: #fff; color: var(--text); }
.btn-login:hover { background: #f1f5f9; box-shadow: 0 4px 12px rgba(255, 255, 255, 0.1); }

.err-msg { font-size: 12px; color: var(--danger); margin-top: 8px; min-height: 18px; font-weight: 500; }

/* ══ App 页头 ═══════════════════════════════════════ */
.app-header {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 1000;
}
.hdr-brand { font-size: 18px; font-weight: 800; color: var(--primary); display: flex; align-items: center; gap: 8px; }
.hdr-meta { flex: 1; display: flex; gap: 12px; justify-content: center; }
.hdr-meta span { background: var(--bg); color: var(--text-lt); padding: 4px 12px; border-radius: 100px; font-size: 12px; font-weight: 600; border: 1px solid var(--border); }
.hdr-user { display: flex; align-items: center; gap: 12px; }
#hdr-uid { font-weight: 700; color: var(--text); }
#btn-logout { background: var(--bg); color: var(--text-lt); border: 1px solid var(--border); padding: 6px 14px; border-radius: var(--r-sm); cursor: pointer; font-size: 12px; font-weight: 600; transition: all 0.2s; }
#btn-logout:hover { background: var(--danger); color: #fff; border-color: var(--danger); }

/* ══ 赛季切换栏 ═════════════════════════════════════ */
.season-bar {
  background: #fff;
  padding: 16px 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid var(--border);
}
.season-bar-label { font-weight: 700; color: var(--text-lt); font-size: 13px; }
#season-tabs { display: flex; gap: 8px; }
.season-tab {
  padding: 6px 16px;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: #fff;
  color: var(--text-lt);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.season-tab:hover { border-color: var(--primary); color: var(--primary); }
.season-tab.active { background: var(--primary); border-color: var(--primary); color: #fff; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2); }

/* ══ 管理员工具栏 ════════════════════════════════════ */
.admin-bar {
  background: #1e293b;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #fff;
  overflow-x: auto;
}
.admin-bar b { font-size: 13px; margin-right: 8px; white-space: nowrap; }
.admin-bar button {
  background: #334155;
  color: #f1f5f9;
  border: none;
  padding: 6px 14px;
  border-radius: var(--r-sm);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}
.admin-bar button:hover { background: #475569; }
.admin-bar button.danger { background: #991b1b; }
.admin-bar button.danger:hover { background: #b91c1c; }

/* ══ 快速跳转 ═══════════════════════════════════════ */
.section-nav {
  background: rgba(248, 250, 252, 0.9);
  backdrop-filter: blur(8px);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 60px;
  z-index: 900;
}
.section-nav-btn {
  background: #fff;
  border: 1px solid var(--border);
  padding: 6px 16px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-lt);
  cursor: pointer;
  transition: all 0.2s;
}
.section-nav-btn:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-1px); box-shadow: var(--shadow-sm); }

/* ══ 主布局 ═════════════════════════════════════════ */
.cards {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.card {
  background: #fff;
  border-radius: var(--r-lg);
  padding: 28px;
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}
.card > h2, .card-h-row h2 {
  font-size: 20px;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.card-h-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}
.card-h-row h2 { margin-bottom: 0; }

/* ══ 过滤器 ═════════════════════════════════════════ */
.sanc-filter-row {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
  padding: 12px 16px;
  background: var(--bg);
  border-radius: var(--r);
}
.check-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-lt);
  cursor: pointer;
}
.check-label input { width: 16px; height: 16px; accent-color: var(--primary); }

/* ══ 庇护所列表 ═════════════════════════════════════ */
#sanc-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}

.sanc-item {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--r);
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}
.sanc-item:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: var(--primary-lt); }

.sanc-header {
  padding: 16px;
  background: #f8fafc;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 12px;
}
.sanc-name { font-weight: 700; font-size: 15px; color: var(--text); flex: 1; }
.sanc-meta { font-size: 11px; color: var(--text-lt); font-weight: 500; }

.sanc-body { padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 16px; }

.user-row { display: flex; gap: 12px; }
.user-row-id { font-weight: 700; color: var(--primary); font-size: 12px; width: 60px; flex-shrink: 0; padding-top: 4px; }
.row-content { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.slots { display: flex; gap: 8px; flex-wrap: wrap; }

/* ══ 精灵标签 ═══════════════════════════════════════ */
.spirit-tag {
  position: relative;
  padding: 8px 12px 20px;
  border-radius: var(--r-sm);
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  min-width: 90px;
  text-align: center;
  box-shadow: var(--shadow-sm);
  text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}
.spirit-tag .tag-user {
  position: absolute;
  bottom: 4px;
  left: 0;
  right: 0;
  font-size: 10px;
  font-weight: 500;
  opacity: 0.9;
}
.spirit-tag.mine { cursor: pointer; transition: all 0.2s; }
.spirit-tag.mine:hover { filter: brightness(1.1); transform: scale(1.05); }

.slot-empty {
  width: 90px;
  height: 45px;
  border: 2px dashed var(--border);
  border-radius: var(--r-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-lt);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  background: #fcfcfc;
}
.slot-empty:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-lt); }

/* ══ 评分系统 ═══════════════════════════════════════ */
.rating-wrapper { border-top: 1px solid var(--border); padding-top: 16px; }
.rating-bar { display: flex; align-items: center; gap: 8px; }
.rating-btn {
  padding: 6px 12px;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: #fff;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.rating-bad { color: var(--danger); }
.rating-ok { color: var(--warning); }
.rating-good { color: var(--success); }

.rating-btn.active.rating-bad { background: var(--danger); color: #fff; border-color: var(--danger); }
.rating-btn.active.rating-ok { background: var(--warning); color: #fff; border-color: var(--warning); }
.rating-btn.active.rating-good { background: var(--success); color: #fff; border-color: var(--success); }

/* ══ 评价区 ════════════════════════════════════════ */
.comment-section { margin-top: 12px; background: var(--bg); border-radius: var(--r-sm); padding: 12px; }
.comment-item { font-size: 12px; margin-bottom: 8px; display: flex; gap: 8px; }
.comment-meta { font-weight: 700; color: var(--text); }
.comment-text { color: var(--text-lt); }
.my-comment-ta {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  padding: 8px;
  font-size: 12px;
  margin-top: 8px;
  resize: none;
}

/* ══ 状态配色 ═══════════════════════════════════════ */
.sanc-rated-good { border-top: 4px solid var(--success); }
.sanc-rated-bad  { border-top: 4px solid var(--danger); }
.sanc-rated-ok   { border-top: 4px solid var(--warning); }

/* ══ 精灵果实列表 ════════════════════════════════════ */
#fruit-list { display: flex; flex-direction: column; gap: 12px; }
.fruit-row {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--r);
  transition: all 0.2s;
}
.fruit-row:hover { border-color: var(--primary-lt); background: #fcfdff; }
.fruit-name { font-weight: 800; font-size: 15px; width: 120px; color: var(--text); }
.fruit-holders { flex: 1; display: flex; gap: 8px; flex-wrap: wrap; }
.holder-tag {
  background: var(--bg);
  color: var(--text-lt);
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 600;
  border: 1px solid var(--border);
}
.holder-mine { background: var(--primary-lt); color: var(--primary); border-color: var(--primary); }

.my-fruit-btn {
  padding: 6px 16px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  border: 1px solid var(--border);
}
.fruit-yes { background: var(--success); color: #fff; border-color: var(--success); }
.fruit-no { background: #fff; color: var(--text-lt); }
.fruit-no:hover { border-color: var(--success); color: var(--success); }

/* ══ 弹窗 ═══════════════════════════════════════════ */
.modal-overlay {
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}
.modal-box {
  background: #fff;
  border-radius: var(--r-lg);
  padding: 32px;
  width: 90%;
  max-width: 500px;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  position: relative;
}
#modal-close {
  position: absolute;
  top: 20px;
  right: 20px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: var(--bg);
  color: var(--text-lt);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  transition: all 0.2s;
}
#modal-close:hover { background: var(--danger); color: #fff; }

.modal-title { font-size: 20px; font-weight: 800; margin-bottom: 20px; color: var(--text); }

/* ══ 表单通用 ═══════════════════════════════════════ */
.form-row { margin-bottom: 16px; }
.form-row label { display: block; font-size: 13px; font-weight: 600; color: var(--text-lt); margin-bottom: 6px; }
.form-row input, .form-row select, .form-row textarea {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  background: var(--bg);
  font-size: 14px;
}
.form-row input:focus { outline: none; border-color: var(--primary); background: #fff; }

/* ══ 按钮类 ═════════════════════════════════════════ */
.btn {
  padding: 10px 20px;
  border-radius: var(--r-sm);
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  border: none;
  font-size: 14px;
}
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2); }
.btn-sm { padding: 6px 12px; font-size: 12px; }

/* ══ 响应式微调 ═════════════════════════════════════ */
@media (max-width: 768px) {
  .app-header { padding: 12px 16px; }
  .hdr-meta { display: none; }
  .cards { padding: 16px; }
  .card { padding: 20px; }
  #sanc-list { grid-template-columns: 1fr; }
}

/* ══ 动画 ═══════════════════════════════════════════ */
.hidden { display: none !important; }

/* ══ 异色蛋组 ══════════════════════════════════════════ */
#egg-group-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}
.egg-group-item {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: all 0.2s;
}
.egg-group-item:hover { border-color: var(--primary-lt); box-shadow: var(--shadow); }
.egg-group-name { font-weight: 800; color: var(--text); font-size: 16px; }

.egg-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 20px;
  padding: 12px;
  background: var(--bg);
  border-radius: var(--r);
}
.egg-legend-item { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; }
.egg-legend-dot { width: 12px; height: 12px; border-radius: 3px; }

.egg-focus-panel {
  background: var(--primary-lt);
  border: 1px solid var(--primary);
  border-radius: var(--r);
  padding: 16px;
  margin-bottom: 20px;
  font-size: 13px;
  color: var(--primary-hover);
  line-height: 1.8;
}
.egg-group-tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  border: 1px solid;
  border-radius: 100px;
  padding: 2px 10px;
  margin: 0 4px;
}

.egg-graph-wrap {
  border: 1px solid var(--border);
  border-radius: var(--r);
  background: #f1f5f9;
  padding: 12px;
  overflow: hidden;
}
.egg-svg { display: block; width: 100%; height: auto; }

/* ══ 批量操作 & 管理工具 ══════════════════════════════ */
.bulk-bar {
  background: var(--primary-lt);
  border: 1px solid var(--primary);
  border-radius: var(--r);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
}
.bulk-bar select {
  padding: 6px 12px;
  border: 1px solid var(--primary);
  border-radius: var(--r-sm);
  background: #fff;
  font-size: 12px;
}

.bulk-select-header {
  padding: 8px 0;
  font-size: 12px;
  color: var(--text-lt);
  display: flex;
  align-items: center;
  gap: 8px;
}

.spirit-checklist-items {
  max-height: 240px;
  overflow-y: auto;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  padding: 8px;
  background: var(--bg);
}
.spirit-check-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px;
  cursor: pointer;
  border-radius: var(--r-sm);
  transition: background 0.2s;
}
.spirit-check-item:hover { background: var(--primary-lt); }

/* ══ 导入/导出 ════════════════════════════════════════ */
.import-section {
  margin-top: 20px;
  border: 2px dashed var(--border);
  border-radius: var(--r);
  padding: 16px;
}
.import-section summary {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-lt);
  cursor: pointer;
  padding: 4px 0;
}
.import-content textarea {
  width: 100%;
  min-height: 100px;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  background: var(--bg);
  font-family: ui-monospace, monospace;
  font-size: 12px;
  margin-top: 12px;
}

/* ══ 赛季精灵特效 ══════════════════════════════════════ */
@keyframes spirit-shine {
  0% { left: -100%; }
  20% { left: 100%; }
  100% { left: 100%; }
}
.fruit-row.season-spirit {
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border: 1px solid #fcd34d;
  position: relative;
  overflow: hidden;
}
.fruit-row.season-spirit::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
  animation: spirit-shine 4s infinite;
}
.season-tag {
  background: #f59e0b;
  color: #fff;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 800;
  margin-left: 8px;
}

/* ══ 地图弹窗 ══════════════════════════════════════════ */
.map-view-btn {
  font-size: 11px;
  color: var(--primary);
  background: var(--primary-lt);
  border: 1px solid var(--primary);
  padding: 2px 8px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
  margin-left: 8px;
}
.map-popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(10px);
}
.map-popup-name { color: #fff; font-size: 18px; font-weight: 800; margin-bottom: 16px; }
.map-popup-overlay img { max-width: 90vw; max-height: 80vh; border-radius: var(--r); box-shadow: 0 0 40px rgba(0,0,0,0.5); }
.map-popup-hint { color: #94a3b8; margin-top: 16px; font-size: 12px; }

/* ══ 筛选器增强 ════════════════════════════════════════ */
.fruit-filter-bar {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 20px;
  padding: 16px;
  background: var(--bg);
  border-radius: var(--r);
}
.element-filter { display: flex; flex-wrap: wrap; gap: 8px; }
.elem-btn {
  padding: 4px 12px;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: #fff;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.elem-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }

.filter-mode-toggle { display: flex; align-items: center; gap: 8px; }
.mode-btn {
  padding: 4px 12px;
  border-radius: 100px;
  border: 1px solid var(--border);
  background: #fff;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}
.mode-btn.active { background: var(--text); color: #fff; border-color: var(--text); }

/* ══ 庇护所分组 ══════════════════════════════════════ */
.location-group { margin-bottom: 20px; }
.location-group-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: var(--r);
  cursor: pointer;
  transition: all 0.2s;
}
.location-group-header:hover { background: var(--bg); border-color: var(--primary-lt); }
.location-name { font-weight: 800; color: var(--text); flex: 1; font-size: 15px; }
.location-count { font-size: 11px; color: var(--text-lt); font-weight: 600; }
.location-toggle { font-size: 11px; color: var(--primary); font-weight: 700; }
.location-group-body { padding-top: 12px; display: flex; flex-direction: column; gap: 12px; }

/* ══ 星光值 & 系别徽章 ══════════════════════════════ */
.star-value-wrap { display: inline-flex; align-items: center; margin-left: 8px; gap: 2px; }
.star-value-badge { font-size: 10px; font-weight: 800; }
.star-v1 { color: #94a3b8; }
.star-v2 { color: #6366f1; }
.star-v3 { color: #f59e0b; text-shadow: 0 0 8px rgba(245, 158, 11, 0.3); }
.star-sep { color: var(--border); font-size: 9px; }

.elem-badge {
  display: inline-block;
  font-size: 10px;
  background: var(--bg);
  color: var(--text-lt);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 6px;
  margin-left: 6px;
  font-weight: 700;
}

/* ══ 管理弹窗内组件 ══════════════════════════════════ */
.spirit-rows { display: flex; flex-direction: column; gap: 8px; max-height: 300px; overflow-y: auto; padding-right: 4px; }
.spirit-row { display: flex; gap: 8px; align-items: center; }
.spirit-row input, .spirit-row select { padding: 8px; font-size: 13px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--bg); }
.spirit-row .spirit-name-inp { flex: 1; }

.add-spirit-form { display: flex; gap: 8px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
.add-spirit-form input { flex: 1; }

.sc-stats { font-size: 11px; color: var(--text-lt); margin-top: 2px; }
.import-format-hint { font-size: 11px; color: var(--text-lt); background: var(--bg); padding: 8px; border-radius: 4px; margin-top: 8px; font-family: monospace; }

.fruit-section-sep { margin: 24px 0; border-top: 1px solid var(--border); position: relative; }
.fruit-section-sep::after { content: '普通精灵'; position: absolute; top: -10px; left: 50%; transform: translateX(-50%); background: #fff; padding: 0 12px; font-size: 12px; color: var(--text-lt); font-weight: 600; }

/* ══ 蛋组关系图 ══════════════════════════════════════ */
.eg-node { cursor: pointer; transition: all 0.2s; }
.eg-node:hover { filter: brightness(1.1); }
.eg-line { stroke: var(--border); stroke-width: 1.5; transition: all 0.2s; }

/* ══ 赛季选择特效 ════════════════════════════════════ */
.pick-section-label { font-size: 12px; font-weight: 800; color: var(--text); margin: 16px 0 8px; text-transform: uppercase; letter-spacing: 0.5px; }
.season-pick { position: relative; overflow: hidden; }
.season-pick::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: spirit-shine 3s infinite;
}
